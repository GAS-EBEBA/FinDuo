    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "express-rate-limit": "^7.5.0",
    "multer": "^2.0.2",
    "mysql2": "^3.14.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
